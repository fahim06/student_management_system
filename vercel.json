{
  "version": 1,
  "builds": [
    {
      "src": "student_management_system/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python",
        "includeFiles": "student_management_app/static/**",
        "applyMigrations": true
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "student_management_system/wsgi.py"
    }
  ]
}